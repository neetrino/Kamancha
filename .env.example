# Application
NODE_ENV=development
# Local: http://localhost:3000
# Production (Vercel): https://kamancha-self.vercel.app — required for OG/link previews
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session / auth
AUTH_SECRET=

# Database (Neon PostgreSQL)
DATABASE_URL=

# Cache / rate limit (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Object storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
# Optional; mirrors R2_PUBLIC_BASE_URL for browser static `/assets/` URLs (auto from next.config when unset)
NEXT_PUBLIC_STATIC_ASSET_BASE_URL=
# Optional; defaults to https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT=

# Email (Resend adapter)
EMAIL_FROM=
RESEND_API_KEY=

# Google Maps (Geocoding + Routes + Maps JavaScript for address picker)
# Enable: Geocoding API, Routes API, Places API (New), Maps JavaScript API
GOOGLE_MAPS_API_KEY=

# Tidio live chat (public key from the widget script URL code.tidio.co/<key>.js)
NEXT_PUBLIC_TIDIO_PUBLIC_KEY=

# Web Push for admin new-order alerts (optional; disabled when keys are empty)
# Generate keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:you@example.com or https://… (web-push rejects http://localhost).
# Defaults to NEXT_PUBLIC_APP_URL only when it is https.
VAPID_SUBJECT=

# Dev/test seed only (never commit real passwords)
